{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearPractice",
  "version": "0.1.0",
  "identifier": "com.clearpractice.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClearPractice",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/recordings/*/audio.wav",
          "$APPLOCALDATA/cache/mic-test/recordings/*/audio.wav",
          "$APPLOCALDATA/cache/inference/*/*/audio.wav",
          "$APPLOCALDATA/clips/*/audio.wav",
          "$APPLOCALDATA/cache/clip-staging/*/full.wav",
          "$APPLOCALDATA/cache/clip-staging/*/speech-16k.wav"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/clips/*"
    ],
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Alex",
    "shortDescription": "Speaking practice that stays on your computer"
  }
}
